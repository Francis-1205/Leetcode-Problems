class Solution {
    public void reverseString(char[] s) {
        
        for (int i = 0; i < s.length / 2; i++) {
            
            int j = s.length - 1 - i; 

            // Perform the swap using a temporary variable:
            
            // 1. Store the character at the left (i).
            char temp = s[i];

            // 2. Overwrite the left (i) with the character from the right (j).
            s[i] = s[j];

            // 3. Overwrite the right (j) with the stored character (original left).
            s[j] = temp;
        }
        // The array 's' is now correctly reversed in-place.
    }
}
