class Solution {
    public int maxProduct(int[] nums) {
        int temp1=0;
       int temp2=0;
       for(int i=0;i<nums.length;i++){
           if(nums[i]>temp1){
               temp2=temp1;
               temp1=nums[i];
           }
           else if(nums[i]>temp2 && temp2<=temp1){
               temp2=nums[i];
           }
       }
       temp1--;
       temp2--;
       return temp1*temp2;
    }
}
