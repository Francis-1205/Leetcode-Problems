class Solution {
    public void rotate(int[] nums, int k) {
        k=k%nums.length;
        reverse(nums,0,nums.length-1);//reversing entire array
        reverse(nums,0,k-1);//reversing upto k value
        reverse(nums,k,nums.length-1);//reversing after the k value 
    }
    public void reverse(int nums[],int s,int e){
        //general reverse of an array
        while(s<e){
        int temp=nums[s];
        nums[s]=nums[e];
        nums[e]=temp;
        s++;
        e--;
        }
    }
}
