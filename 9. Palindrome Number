class Solution {
    public boolean isPalindrome(int x) {
        int rev=0;
        int lastdigit=0;
        int duplicate=x;
        while(x>0){
            lastdigit=x%10;
            rev=(rev*10)+lastdigit;
            x=x/10;
        }
        if(duplicate==rev){
                return true;
            }
        return false;
    }
}
