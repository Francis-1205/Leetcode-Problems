import java.util.ArrayList;

class Solution {
    public void moveZeroes(int[] nums) {
        int count = 0;
        ArrayList<Integer> list = new ArrayList<>();

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] == 0) {
                count++;
            } else {
                list.add(nums[i]);
            }
        }

        for (int i = 0; i < count; i++) {
            list.add(0);
        }
        for (int i = 0; i < nums.length; i++) {
            nums[i] = list.get(i);
        }
    }
}
